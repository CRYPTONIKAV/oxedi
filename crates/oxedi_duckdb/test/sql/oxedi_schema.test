SELECT (SELECT string_agg(column_name || ' ' || column_type, ', ')
        FROM (DESCRIBE SELECT * FROM read_835('../oxedi_core/tests/fixtures/balanced_5010_sample.txt', table_name := 'claims', version := '5010')))
     = (SELECT string_agg(column_name || ' ' || column_type, ', ' ORDER BY position)
        FROM oxedi_schema(version := '5010') WHERE table_name = 'claims');
