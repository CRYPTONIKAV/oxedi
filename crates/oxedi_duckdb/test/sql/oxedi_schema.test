# name: test/sql/oxedi_schema.test
# description: oxedi_schema describes every table read_835 returns, with the types DESCRIBE gives,
#              for both versions and with binary; reference columns name their table
# group: [oxedi]

require oxedi

# ---- the columns and types equal DESCRIBE of read_835, table by table ----

query I
SELECT (SELECT string_agg(column_name || ' ' || column_type, ', ')
        FROM (DESCRIBE SELECT * FROM read_835('../oxedi_core/tests/fixtures/balanced_5010_sample.txt', table_name := 'adjustments', version := '5010')))
     = (SELECT string_agg(column_name || ' ' || column_type, ', ' ORDER BY position)
        FROM oxedi_schema(version := '5010') WHERE table_name = 'adjustments');
----
true

